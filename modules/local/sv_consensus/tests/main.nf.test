nextflow_process {
    name "SV_CONSENSUS process interface"
    script "../main.nf"
    process "SV_CONSENSUS"
    options "-stub-run"
    test("Stages inputs and emits the declared outputs") {
        when {
            params { outdir = "$outputDir/results" }
            process {
                """
                    input[0] = [[id:'TEST',patient:'P',type:'normal',normal:'N'], file("$projectDir/tests/staging/f1"), file("$projectDir/tests/staging/f2")]
                """
            }
        }
        then { assert process.success; assert process.out[0].size() == 1 }
    }
}
