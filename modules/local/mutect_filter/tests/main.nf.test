nextflow_process {
    name "MUTECT_FILTER process interface"
    script "../main.nf"
    process "MUTECT_FILTER"
    options "-stub-run"
    test("Stages inputs and emits the declared outputs") {
        when {
            params { outdir = "$outputDir/results" }
            process {
                """
                    input[0] = [[id:'TEST',patient:'P',type:'normal',normal:'N'], file("$projectDir/tests/staging/f1"), file("$projectDir/tests/staging/f2"), file("$projectDir/tests/staging/f3"), file("$projectDir/tests/staging/f4"), file("$projectDir/tests/staging/f5"), file("$projectDir/tests/staging/f6")]
                    input[1] = file("$projectDir/tests/staging/f7")
                """
            }
        }
        then { assert process.success; assert process.out[0].size() == 1 }
    }
}
