manifest {
    name = 'clinvarflow'
    version = '0.1.0'
    nextflowVersion = '>=24.10.4'
}
params {
    input = null
    reference = null
    outdir = 'results'
    assay = 'wes'
    tools = 'germline,somatic,cnv,sv,fusion'
    image_prefix = 'clinvarflow'
    arriba_only = false
    genes = "${projectDir}/assets/cancer_genes.txt"
    benchmark_sample = null
    min_f1 = 0.95
    demo = false
    load_db = false
    annovar_protocols = null
    annovar_dir = null
}
includeConfig 'conf/base.config'
profiles {
    wiring { process { withLabel:standard { cpus=1; memory="256 MB" }; withLabel:large { cpus=1; memory="256 MB" } } }
    test { params.demo = true }
    docker { docker.enabled = true }
    conda { conda.enabled = true }
    awsbatch { includeConfig 'conf/awsbatch.config' }
}
